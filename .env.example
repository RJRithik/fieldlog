# Copy this file to .env for local runs. NEVER commit the real .env file.
ASSEMBLYAI_API_KEY=your-assemblyai-api-key-here

# Optional: longest a single demo session may run, in seconds (60-10800). Default 300.
MAX_SESSION_SECONDS=300

# Optional: if set, visitors must enter this passcode before a session can start.
# DEMO_PASSCODE=choose-something
